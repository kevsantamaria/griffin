{
  "languages": {
    "TypeScript": {
      "language_servers": ["vtsls", "oxlint", "!typescript-language-server"],
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "./node_modules/.bin/oxfmt",
          "arguments": ["--stdin-filepath", "{buffer_path}"],
        },
      },
    },
    "Vue.js": {
      "language_servers": ["vue-language-server", "oxlint", "vtsls"],
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "./node_modules/.bin/oxfmt",
          "arguments": ["--stdin-filepath", "{buffer_path}"],
        },
      },
    },
  },

  "lsp": {
    "oxlint": {
      "initialization_options": {
        "settings": {
          "run": "onType",
          "fixKind": "safe_fix",
          "typeAware": true,
          "tsconfig": "tsconfig.json",
        },
      },
    },
  },
}
